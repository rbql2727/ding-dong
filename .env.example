# Supabase 대시보드 → Project Settings → API (또는 Data API) 에서 복사하세요.
# 이 파일을 복사해서 .env 를 만들고 실제 값을 넣으세요. (.env 는 git 에 올라가지 않습니다)

# 프로젝트 URL (예: https://abcdefghijkl.supabase.co)
VITE_SUPABASE_URL=

# 공개용 키: "anon public" 키 또는 "Publishable key"(sb_publishable_...)
# 주의: service_role / secret 키는 절대 넣지 마세요. 앱에 넣으면 누구나 모든 데이터를 볼 수 있게 됩니다.
VITE_SUPABASE_ANON_KEY=
